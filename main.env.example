# Copy this file to `main.env` and fill in your bot's credentials.
# `dotenvy` reads it on startup; never commit the real `main.env`.

# https://discord.com/developers/applications  →  "Bot" tab
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# https://discord.com/developers/applications  →  "General Information" tab
DISCORD_APP_ID=YOUR_APPLICATION_ID_HERE

# Optional – route requests through a VPN/proxy.
# If present, every request to miniblox.io goes through this address.
# Accepts any scheme reqwest::Proxy understands (http, https, socks5).
PROXY_URL=

# Optional – comma-separated list of extra proxy URLs to round-robin
# through. Mutually exclusive with PROXY_URL.
PROXY_POOL=
